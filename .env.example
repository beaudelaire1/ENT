# Ce fichier est copié tel quel dans les secrets d'un déploiement : ses valeurs par
# défaut sont donc celles de la production. Pour le développement local, mettre
# DJANGO_DEBUG=true après la copie.
#
# Ne jamais remplacer les placeholders ci-dessous par de vraies valeurs dans CE fichier :
# il est suivi par git (`.gitignore` l'exempte explicitement de l'exclusion de `.env*`).
# Les vraies valeurs vont dans les secrets Coolify, ou dans un `.env` local qui, lui,
# reste ignoré.
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Explicite seulement en dérogation : sans certificat valable encore (domaine de test,
# Coolify sslip.io que Let's Encrypt refuse souvent de certifier faute de quota), poser
# DJANGO_FORCE_HTTPS=false lève la redirection et les cookies sécurisés sans toucher à
# DJANGO_DEBUG. Laissé vide, le comportement suit DJANGO_DEBUG comme avant.
DJANGO_FORCE_HTTPS=
POSTGRES_DB=myent
POSTGRES_USER=myent
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://myent:myent@postgres:5432/myent
REDIS_URL=redis://redis:6379/0
DEFAULT_FROM_EMAIL=MyENT <noreply@example.test>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
BACKUP_S3_BUCKET=
BACKUP_DAILY_RETENTION=14
BACKUP_WEEKLY_RETENTION=8
BACKUP_MONTHLY_RETENTION=12
SITE_URL=http://localhost:8000
# Destinataires des erreurs serveur et des échecs de sauvegarde, séparés par des virgules.
DJANGO_ADMINS=
SERVER_EMAIL=
LIBRARY_MAX_UPLOAD_MB=25
AUDIO_MAX_TRACK_MB=1024
AUDIO_DEFAULT_QUOTA_MB=10240
CSP_EXTERNAL_MEDIA_SOURCES=
# Emplacement interne du proxy pour la remise des fichiers privés (X-Accel-Redirect).
# Doit être déclaré `internal` côté proxy — et suppose un proxy Nginx, ce que Coolify
# n'est pas par défaut (Traefik). Vide, Django sert les fichiers lui-même.
MEDIA_INTERNAL_LOCATION=
# Collecte des erreurs. Vide, Sentry n'est pas monté et seules les alertes par
# courriel (DJANGO_ADMINS) subsistent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
GUNICORN_TIMEOUT=900
